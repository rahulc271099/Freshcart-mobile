# Copy this file to `.env` (gitignored — never commit real values) and
# fill in real values for local development. Same convention as
# android/local.properties.example / ios GoogleService-Info.plist.example.
#
# Loaded via react-native-config. After editing `.env` you must rebuild the
# native app — a Metro reload alone does NOT pick up Config changes:
#   npm run android
#   npm run ios

# Backend base URL for all API requests. Consumed in src/config/api.ts.
API_BASE_URL=http://172.24.203.39:8000/api/v1

# Razorpay *publishable* Key ID only — never the Key Secret, which stays
# server-side. From the Razorpay dashboard. Consumed in src/constants/env.ts.
RAZORPAY_KEY_ID=
